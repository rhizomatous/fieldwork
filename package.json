{
  "name": "agent-in-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:guest": "node scripts/smoke-guest.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "guest": "bash scripts/build-guest.sh",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@mlc-ai/web-llm": "0.2.85",
    "@uiw/react-codemirror": "4.25.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wanix": "0.4.0-rc2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@webgpu/types": "0.1.74",
    "esbuild": "0.28.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
