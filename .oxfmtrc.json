{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "ignorePatterns": [
    "dist/**",
    "public/runtime/**",
    ".cache/**",
    "**/node_modules/**",
    "**/package-lock.json"
  ],
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      "parent",
      ["sibling", "index"],
      "style",
      "unknown"
    ],
    "newlinesBetween": true,
    "sortSideEffects": false
  }
}
